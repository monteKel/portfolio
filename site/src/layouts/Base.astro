---
import '../styles/fonts.css';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import { LANGS, type Lang } from '../data/content';
// fontes latinas pré-carregadas: o texto aparece mais cedo e sem pular quando a fonte chega
import monoLatin from '../fonts/martian-mono-latin-standard-normal.woff2?url';
import sansLatin from '../fonts/ibm-plex-sans-latin-wght-normal.woff2?url';

interface Props {
  lang: Lang;
  /** fontes a pré-carregar (ex.: japonês na /ja/) */
  preload?: string[];
  title: string;
  description: string;
}
const { lang, title, description, preload: extraFonts = [] } = Astro.props;
const preload = [monoLatin, sansLatin, ...extraFonts];
const site = Astro.site!;
const me = LANGS.find((l) => l.code === lang)!;
const urlOf = (path: string) => new URL(path, site).href;
const canonical = urlOf(me.path);
// caminhos dos outros idiomas para o /lang-gate.js (data-alt-en, data-alt-pt, data-alt-ja)
const alts = Object.fromEntries(LANGS.map((l) => [`data-alt-${l.code}`, l.path]));

// Mesma política do _headers (meta não aceita frame-ancestors): defesa extra
// para quando o site estiver num host que não define headers.
const csp = [
  "default-src 'none'",
  "script-src 'self'",
  "style-src 'self'",
  "img-src 'self'",
  "font-src 'self'",
  // API do jogo do detetive (VM própria, via Cloudflare Tunnel); igual ao _headers
  "connect-src 'self' https://api.kelvecartaxo.dev",
  "worker-src 'self'",
  "manifest-src 'self'",
  "base-uri 'none'",
  "form-action 'none'",
  "object-src 'none'",
].join('; ');
---
<!doctype html>
<html lang={me.hreflang} {...alts}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline src="/lang-gate.js"></script>
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l.hreflang} href={urlOf(l.path)} />)}
    <link rel="alternate" hreflang="x-default" href={urlOf('/')} />
    {preload.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <noscript><link rel="stylesheet" href="/noscript.css" /></noscript>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={me.ogLocale} />
    <!-- prévia de link (LinkedIn, X, WhatsApp): gerada do próprio site por scripts/og.py -->
    <meta property="og:image" content={urlOf(`/og/og-${lang}.jpg`)} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={urlOf(`/og/og-${lang}.jpg`)} />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
